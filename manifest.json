{
  "manifest_version": 3,
  "name": "Spot the Pod",
  "short_name": "Spot the Pod",
  "version": "3.0.0",
  "description": "Discover podcasts and listen while you browse.",
  "minimum_chrome_version": "109",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["https://itunes.apple.com/*"],
  "action": { "default_title": "Spot the Pod", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png" } },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "64": "icons/64.png", "128": "icons/128.png", "256": "icons/256.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: data:; media-src https: http:" }
}
