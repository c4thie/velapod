{
  "manifest_version": 3,
  "name": "VelaPod",
  "short_name": "VelaPod",
  "version": "3.1.0",
  "description": "Discover podcasts and listen while you browse.",
  "minimum_chrome_version": "109",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["https://itunes.apple.com/*"],
  "action": {
    "default_title": "VelaPod",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: data:; media-src https: http:" }
}
